<style>
  .btn-search{
    background-color:#fe424d;
    color:white;
    border-radius:25px;
    padding:0 1rem;
  }
  .btn-search:hover{
    background-color:#fe4271;
    color:white;
  }
  .btn-search i{
    margin-right:0.5rem;
  }
  .search-input{
    border-radius:25px;
    padding:0.5rem 3rem;
    font-size:1rem;
  }

  @media (min-width: 768px){
    .search-input{
      min-width:420px;
    }
  }

  .offcanvas{
    width:85%;
  }
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid align-items-center">

    <!-- LEFT: LOGO + EXPLORE -->
    <div class="d-flex align-items-center">
      <a class="navbar-brand me-2" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <a class="nav-link fw-semibold ms-4" href="/listings">Explore</a>
    </div>

    <!-- CENTER: BIG SEARCH (DESKTOP ONLY) -->
    <div class="d-none d-md-flex flex-grow-1 justify-content-center px-4">
      <form class="d-flex w-120" role="search" action="/listings/search" method="GET">
        <input
          class="form-control search-input"
          type="search"
          name="place"
          placeholder="Search destinations" required>
        <button class="btn btn-search ms-4 w-75" type="submit">
          <i class="fa-solid fa-magnifying-glass "></i>Search
        </button>
      </form>
    </div>

    <!-- RIGHT: NAV ITEMS (DESKTOP) -->
    <div class="d-none d-md-flex align-items-center gap-4">

      <a class="nav-link p-0" href="/listings/new">Airbnb your home</a>

      <% if(!currUser) { %>
        <a class="nav-link fw-bold" href="/signup">Signin</a>
        <a class="nav-link fw-bold" href="/login">Login</a>
      <% } %>

      <% if(currUser) { %>
        <a class="nav-link p-0" href="/logout">Logout</a>
      <% } %>

    </div>

    <!-- MOBILE TOGGLER -->
    <button class="navbar-toggler d-md-none ms-auto"
       type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#mobileMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

  </div>
</nav>

<!-- MOBILE OFFCANVAS MENU -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title">Browse</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>

  <div class="offcanvas-body">

    <div class="card shadow-sm">
      <div class="card-body">

        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <hr>

        <% if(!currUser) { %>
          <a class="nav-link fw-bold mb-3" href="/signup">Signin</a>
          <a class="nav-link" href="/login">Login</a>
        <% } %>

        <% if(currUser) { %>
          <a class="nav-link text-danger" href="/logout">Logout</a>
        <% } %>

      </div>
    </div>

  </div>
</div>
