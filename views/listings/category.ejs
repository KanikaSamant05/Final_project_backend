<% layout("/layouts/boilerplate") %>

<div class="container mt-3">

  <!-- Category Heading -->
  <div class="row mb-3">
    <div class="col-12 text-center">
      <h3><%= category %></h3>
      <hr class="w-50 mx-auto">
    </div>
  </div>

  <!-- Listings -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% if (listings.length === 0) { %>
      <div class="justify-content-center align-items-center mt-3" style="min-height:50vh;" >
        <h5 class="text-center">Oops! Nothing to show here 😕</h5>
          <p class="text-muted text-center">Looks like no one has listed anything in this category yet. Try exploring other categories or add your own listing!</p>
      </div>
    <% } %>

    <% for (let listing of listings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
        <div class="card col listing-card mb-4">

          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            style="height: 20rem; object-fit: cover;"
            alt="listing_image"
          >

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b> <br>
              <%= listing.description %> <br>
              <%= listing.country %> <br>
              &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
              <i class="taxInfo"> &nbsp; +18% GST </i>
            </p>
          </div>

        </div>
      </a>
    <% } %>

  </div>
  </div>